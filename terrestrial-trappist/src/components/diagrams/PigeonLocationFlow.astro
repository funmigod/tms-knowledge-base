---
import DiagramFrame from './DiagramFrame.astro';
---

<DiagramFrame
	label="Pigeon Location Flow"
	viewBox="0 0 1020 400"
	ariaLabel="Pigeon location data flow diagram"
	description="Maverick sends driver location updates to Pigeon every five seconds. Pigeon then serves the latest vehicle location to both BVR and Galileo."
>
	<!-- Fixed connector paths matching the reference layout. -->
	<g class="connectors">
		<path d="M 260 200 H 400" />
		<path d="M 620 200 H 678 Q 700 200 700 178 V 112 Q 700 90 722 90 H 760" />
		<path d="M 620 200 H 678 Q 700 200 700 222 V 288 Q 700 310 722 310 H 760" />
	</g>

	<!-- Ordered steps, one badge per connector, matching the connectors group above. -->
	<g class="step-badges">
		<g transform="translate(330 200)">
			<circle r="12" />
			<text y="4">1</text>
		</g>
		<g transform="translate(700 168)">
			<circle r="12" />
			<text y="4">2</text>
		</g>
		<g transform="translate(700 232)">
			<circle r="12" />
			<text y="4">3</text>
		</g>
	</g>

	<!-- Short edge labels replace the mermaid edge text at each connector's midpoint. -->
	<g class="edge-labels">
		<text x="320" y="180">Update every 5s</text>
		<text x="700" y="141">Latest location</text>
		<text x="700" y="259">Latest location</text>
	</g>

	<a href="/frontend-services/maverick/" class="node-link" aria-label="Maverick — read the Maverick service page">
		<g class="node" transform="translate(40 150)">
			<rect width="220" height="100" rx="14" />
			<text x="110" y="58">Maverick</text>
		</g>
	</a>

	<g class="node" transform="translate(400 150)">
		<rect width="220" height="100" rx="14" />
		<text x="110" y="58">Pigeon</text>
	</g>

	<a href="/frontend-services/bvr/" class="node-link" aria-label="BVR — read the BVR service page">
		<g class="node" transform="translate(760 40)">
			<rect width="220" height="100" rx="14" />
			<text x="110" y="58">BVR</text>
		</g>
	</a>

	<a href="/frontend-services/galileo/" class="node-link" aria-label="Galileo — read the Galileo service page">
		<g class="node" transform="translate(760 260)">
			<rect width="220" height="100" rx="14" />
			<text x="110" y="58">Galileo</text>
		</g>
	</a>
</DiagramFrame>

