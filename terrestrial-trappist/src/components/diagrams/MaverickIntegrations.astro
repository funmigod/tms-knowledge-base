---
import DiagramFrame from './DiagramFrame.astro';
---

<DiagramFrame
	label="Maverick Integrations"
	viewBox="0 0 820 500"
	ariaLabel="Maverick service dependencies"
	description="Maverick, GoBolt's driver mobile app, connects to three backend services: it sends login, route, and status data to Core; integrates with Silver during route execution; and streams location updates to Pigeon every five seconds."
>
	<!-- Hub-and-spoke connectors: Maverick fans out to each backend service. -->
	<g class="connectors">
		<path d="M 290 250 H 400 Q 420 250 420 230 V 120 Q 420 100 440 100 H 550" />
		<path d="M 290 250 H 550" />
		<path d="M 290 250 H 400 Q 420 250 420 270 V 380 Q 420 400 440 400 H 550" />
	</g>

	<g class="edge-labels">
		<text x="420" y="171">Login, routes &amp; status updates</text>
		<text x="420" y="242">Route execution link</text>
		<text x="420" y="321">Location update every 5s</text>
	</g>

	<g class="node" transform="translate(50 195)">
		<rect width="240" height="110" rx="14" />
		<text x="120" y="61">Maverick</text>
	</g>

	<a href="/backend-services/core/" class="node-link" aria-label="Core — read the Core service page">
		<g class="node" transform="translate(550 50)">
			<rect width="220" height="100" rx="14" />
			<text x="110" y="56">Core</text>
		</g>
	</a>

	<a href="/backend-services/silver/" class="node-link" aria-label="Silver — read the Silver service page">
		<g class="node" transform="translate(550 200)">
			<rect width="220" height="100" rx="14" />
			<text x="110" y="56">Silver</text>
		</g>
	</a>

	<a href="/backend-services/pigeon/" class="node-link" aria-label="Pigeon — read the Pigeon service page">
		<g class="node" transform="translate(550 350)">
			<rect width="220" height="100" rx="14" />
			<text x="110" y="56">Pigeon</text>
		</g>
	</a>
</DiagramFrame>

