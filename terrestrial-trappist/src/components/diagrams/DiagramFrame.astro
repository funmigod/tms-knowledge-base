---
interface Props {
	label: string;
	viewBox: string;
	ariaLabel: string;
	description: string;
}

const { label, viewBox, ariaLabel, description } = Astro.props;
---

<figure class="diagram">
	<figcaption class="diagram-toolbar">
		<span>{label}</span>
	</figcaption>
	<svg viewBox={viewBox} role="img" aria-label={ariaLabel} aria-describedby="diagram-description">
		<desc id="diagram-description">{description}</desc>

		<defs>
			<marker id="arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
				<path d="M 0 0 L 10 5 L 0 10 z" />
			</marker>
			<filter id="shadow" x="-20%" y="-20%" width="140%" height="150%">
				<feDropShadow dx="0" dy="4" stdDeviation="7" flood-color="#1a1410" flood-opacity="0.12" />
			</filter>
		</defs>

		<slot />
	</svg>
</figure>

<style is:global>
	.diagram {
		margin: 2rem 0 1.5rem;
		overflow-x: auto;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--sl-color-gray-6);
		box-shadow: 0 18px 40px rgb(0 0 0 / 12%);
	}

	.diagram-toolbar {
		padding: 0.7rem 0.85rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}

	.diagram-toolbar > span {
		color: var(--sl-color-accent-high);
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.diagram svg {
		display: block;
		width: 100%;
		height: auto;
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
	}

	.diagram .node-link {
		cursor: pointer;
	}

	.diagram .node-link:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
		border-radius: 14px;
	}

	.diagram .node rect {
		fill: var(--sl-color-bg);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		transition: stroke 140ms ease, transform 140ms ease;
		transform-box: fill-box;
		transform-origin: center;
	}

	.diagram .node-link:hover .node rect,
	.diagram .node-link:focus-visible .node rect {
		stroke: var(--sl-color-accent);
		transform: scale(1.015);
	}

	html[data-theme='light'] .diagram .node rect {
		filter: url(#shadow);
	}

	.diagram .node text {
		fill: var(--sl-color-white);
		font-size: 17px;
		font-weight: 550;
		text-anchor: middle;
	}

	.diagram .connectors {
		fill: none;
		stroke: var(--sl-color-gray-3);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		marker-end: url(#arrow);
	}

	.diagram .connectors path.both {
		marker-start: url(#arrow);
	}

	.diagram .connectors marker path,
	.diagram #arrow path {
		fill: var(--sl-color-gray-3);
	}

	/* A de-emphasised connector: dashed and faded, for secondary or indirect relationships. */
	.diagram .connectors path.soft {
		stroke-dasharray: 5 5;
		opacity: 0.75;
	}

	/* Secondary line inside a node, e.g. "(Route Optimization)". */
	.diagram .node text.subtitle {
		fill: var(--sl-color-gray-2);
		font-size: 12.5px;
		font-weight: 500;
	}

	/* Text sitting on a connector. The halo stroke keeps it legible where it overlaps a line. */
	.diagram .edge-labels text {
		fill: var(--sl-color-gray-2);
		font-size: 13px;
		font-weight: 600;
		text-anchor: middle;
		paint-order: stroke;
		stroke: var(--sl-color-gray-6);
		stroke-width: 8px;
		stroke-linejoin: round;
	}

	/* Numbered badges pinned to connectors, keyed to the ordered steps in the page prose. */
	.diagram .step-badges circle {
		fill: var(--sl-color-accent);
		stroke: var(--sl-color-gray-6);
		stroke-width: 3;
	}

	.diagram .step-badges text {
		fill: #241a08;
		font-size: 12px;
		font-weight: 750;
		text-anchor: middle;
	}

	/* An organization, rather than a service: accent-tinted border plus a small "ORG" eyebrow tag. */
	.diagram .node.is-org rect {
		stroke: color-mix(in srgb, var(--sl-color-accent) 35%, var(--sl-color-gray-4));
	}

	.diagram .node-link:hover .node.is-org rect,
	.diagram .node-link:focus-visible .node.is-org rect {
		stroke: var(--sl-color-accent);
	}

	.diagram .node .eyebrow-tag {
		fill: var(--sl-color-accent-low);
	}

	.diagram .node text.eyebrow {
		fill: var(--sl-color-accent-high);
		font-size: 10.5px;
		font-weight: 750;
		letter-spacing: 0.08em;
	}

	/* The hub of a dependency graph, set apart from its spokes by a stronger accent border. */
	.diagram .node.is-hub rect {
		stroke: color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-gray-4));
	}
</style>
